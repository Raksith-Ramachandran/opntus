# Copy to .env — NEVER commit real values

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# MongoDB Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/opntus

# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_STRONG_RANDOM_64_CHAR_SECRET
JWT_EXPIRES_IN=7d

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_SALT=CHANGE_THIS_RANDOM_SALT

# Key required to create listener accounts
ADMIN_REGISTRATION_KEY=CHANGE_THIS_ADMIN_KEY
