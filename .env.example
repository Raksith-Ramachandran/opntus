# ─── OPNTUS Root Environment Reference ──────────────────────────────────────
# See frontend/.env.example and backend/.env.example for per-service configs.
#
# Quick reference of ALL variables used across the project:
#
# FRONTEND (frontend/.env.local):
#   NEXT_PUBLIC_API_URL=http://localhost:5000/api
#   NEXT_PUBLIC_WS_URL=http://localhost:5000
#   NEXT_PUBLIC_APP_NAME=OPNTUS
#
# BACKEND (backend/.env):
#   NODE_ENV=development
#   PORT=5000
#   FRONTEND_URL=http://localhost:3000
#   MONGODB_URI=mongodb://localhost:27017/opntus
#   JWT_SECRET=<64-char random hex>
#   JWT_EXPIRES_IN=7d
#   IP_SALT=<32-char random hex>
#   ADMIN_REGISTRATION_KEY=<your-secret-key>
